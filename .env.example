# ============================================================
# MyVlessBot — Шаблон конфигурации (.env.example)
# Скопируйте в .env и заполните своими значениями
# ============================================================

# --- Обязательные ---
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
ADMIN_TELEGRAM_ID=123456789
DOMAIN=yourdomain.com
FLASK_SECRET_KEY=generate_a_long_random_secret_here

# IP-адреса, которые не блокируются внутренними лимитерами админки/subscription.
# Можно указывать через пробел, запятую или CIDR.
ADMIN_IP_ALLOWLIST=94.183.234.189 79.139.250.224

# Непосредственные reverse proxy, которым разрешено задавать X-Forwarded-For.
# Значение по умолчанию уже покрывает localhost и стандартную Docker bridge-сеть.
# TRUSTED_PROXY_CIDRS=127.0.0.0/8,::1/128,172.16.0.0/12

# --- Опционально: приложение может получить username через Bot API ---
# TELEGRAM_BOT_USERNAME=your_bot_username

# --- 3x-ui панель ---
PANEL_LOGIN=admin
PANEL_PASSWORD=your_panel_password

# --- База данных ---
# DB_PATH=./users.db  # Путь по умолчанию

# --- Web update manager (production default: disabled) ---
# ВНИМАНИЕ: при включении использует git reset --hard origin/main.
ENABLE_WEB_UPDATES=false

# --- Поддержка (опционально) ---
# SUPPORT_BOT_TOKEN=your_support_bot_token
# support_group_id задаётся позже в админке (/settings)

# --- YooKassa ---
# YOOKASSA_ENABLED=false
# YOOKASSA_SHOP_ID=
# YOOKASSA_SECRET_KEY=

# --- CryptoBot ---
# CRYPTOBOT_ENABLED=false
# CRYPTOBOT_TOKEN=
# CRYPTOBOT_WEBHOOK_SECRET=
